-- Fungsi Fitur Drag (Bisa Digeser)
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    TweenService:Create(ToggleButton, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
end

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then update(input) end
end)

-- Fungsi Klik Buka-Tutup Aman
ToggleButton.MouseButton1Click:Connect(function()
    ToggleButton:TweenSize(UDim2.fromOffset(38, 38), "Out", "Quad", 0.08, true, function()
        ToggleButton:TweenSize(UDim2.fromOffset(45, 45), "Out", "Quad", 0.08, true)
    end)
    
    -- Memastikan pencarian ulang kontainer utama agar akurat saat dieksekusi berkali-kali
    local TargetGui = CoreGui:FindFirstChild("Fluent") or game.Players.LocalPlayer.PlayerGui:FindFirstChild("Fluent")
    if TargetGui then
        TargetGui.Enabled = not TargetGui.Enabled
    else
        Window:Minimize()
    end
end)

Library.OnUnload(function()
    if ToggleGui.Name == "FluentToggleGui" then
        ToggleGui:Destroy()
    else
        ToggleButton:Destroy()
    end
end)
